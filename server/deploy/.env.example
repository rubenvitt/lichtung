# Lichtung – .env.example (VORLAGE, enthält keine echten Werte)
#
# Nicht direkt befüllen. ./generate-secrets.sh liest diese Vorlage und
# schreibt das Ergebnis nach .env (von git ignoriert, Rechte 600), die
# compose.yaml per env_file lädt. Statische Werte stehen in compose.yaml.
#
# Platzhalter:
#   WILL_BE_GENERATED  wird vom Skript zufällig erzeugt
#   CHANGEME_MANUAL    wird vom Skript abgefragt

# Pocket-ID (MANUAL) – OIDC-Client in Pocket-ID anlegen,
# Callback-URL: https://lichtung.rubeen.dev/auth/callback
LICHTUNG_OIDC_ISSUER=CHANGEME_MANUAL
LICHTUNG_OIDC_CLIENT_ID=CHANGEME_MANUAL
LICHTUNG_OIDC_CLIENT_SECRET=CHANGEME_MANUAL
# Die eine Person, die sich anmelden darf (E-Mail des Pocket-ID-Kontos)
LICHTUNG_OIDC_ALLOWED_EMAIL=CHANGEME_MANUAL

# Sitzungen (GENERATED)
LICHTUNG_SESSION_SECRET=WILL_BE_GENERATED

# Schlüssel für die Zugangsdaten der Kalenderkonten (GENERATED, 32 Byte base64).
# Gut aufbewahren: Ohne ihn sind gespeicherte Zugangsdaten (auch in Backups)
# nicht mehr lesbar. Nicht nachträglich ändern.
LICHTUNG_SECRET_KEY=WILL_BE_GENERATED
